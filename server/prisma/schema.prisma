// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  PROFESSOR
  HOD
  DEAN
}

enum RoomType {
  CLASSROOM
  LAB
  OTHER
}

enum CourseType {
  LECTURE
  LAB
  TUTORIAL
}

model Department {
  id        String   @id @default(uuid())
  name      String
  shortCode String   @unique
  branches  Branch[]
  rooms     Room[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id           String      @id @default(uuid())
  name         String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses      Course[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Room {
  id           String      @id @default(uuid())
  roomNumber   String
  capacity     Int
  type         RoomType
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  slots        TimetableSlot[]
  
  @@unique([roomNumber, departmentId])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Course {
  id           String      @id @default(uuid())
  code         String
  name         String
  credits      Int
  type         CourseType
  semester     Int
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  slots        TimetableSlot[]

  @@unique([code, branchId, semester])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  role         Role
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  password     String
  slots        TimetableSlot[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TimetableSlot {
  id           String      @id @default(uuid())
  day          String      // e.g. "Monday"
  period       Int         // 1 to 9 (I through IX)
  section      String      // e.g. "VI A"
  
  roomId       String
  room         Room        @relation(fields: [roomId], references: [id])
  
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id])
  
  facultyId    String
  faculty      User        @relation(fields: [facultyId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
